# User-supplied media: the song and its lyrics are NOT redistributed in this repo.
assets/song.mp3
assets/lyrics.lrc
assets/*.mp3
assets/*.lrc
# Fonts are downloaded by tools/fetch_fonts.sh (SIL OFL, fetched from Google Fonts)
assets/fonts/
# Render outputs
out/
*.mp4
*.mov
*.png
!docs/*.png
__pycache__/
*.pyc

# rendered videos that are kept in the repo
!videos/
!videos/*.mp4

# vocaloid_mv project: keep its engine LUTs, analysis plots and generated art (its own .gitignore excludes
# node_modules, vendor, fonts, the song, the lyrics and *.raw.png)
!vocaloid_mv/assets/**/*.png
!vocaloid_mv/analysis/*.png
!vocaloid_mv/docs/**/*.png
