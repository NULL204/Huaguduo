# vocaloid-style-mv project -- ignore rules (paths are relative to the project root).
# Ignored = fetched or built by setup, generated by a tool, or private (the song). Keep code, docs, timelines,
# palettes, prompts and the curated analysis (audio.json, sections.json, lyrics_mv.lrc).
# Author: NikusonP -- vocaloid-style-mv-pipeline, MIT licence.

# ---------------------------------------------------------------- dependencies (setup.ps1 / setup.sh)
node_modules/
vendor/
__pycache__/
*.py[cod]
.venv/
venv/
npm-debug.log*

# ---------------------------------------------------------------- fetched / built by setup
/engine/fonts/*.ttf
/engine/fonts/*.otf
/engine/fonts/*.woff
/engine/fonts/*.woff2
/jizura/app/jizura_engine.js
/jizura/parts.json
/jizura/probe*/

# ---------------------------------------------------------------- the song (never publish someone's master)
/audio/*.wav
/audio/*.mp3
/audio/*.flac
/audio/*.m4a
/audio/*.aac
/audio/*.ogg

# ---------------------------------------------------------------- analysis by-products (re-creatable)
/analysis/stems/
/analysis/asr/
/analysis/*.npy
/analysis/*.npz
/analysis/click_preview.m4a

# ---------------------------------------------------------------- generated media
/render/
/blender/renders/
/_probe/
*.blend1
# tools/imagegen.py keeps the un-keyed chroma-key original next to each RGBA asset
/assets/**/*.raw.png
*.mp4
*.mov
*.mkv

# ---------------------------------------------------------------- OS / editors / local agent settings
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

# ---------------------------------------------------------------- 花骨朵: lyrics stay local (official text, user-provided)
# The engine reads them at runtime from analysis/lyrics_mv.lrc; never commit lyric text or lyric-derived glyph lists.
/analysis/*.lrc
/analysis/lyrics*.json
/analysis/lyric*.txt
/engine/fonts/subset_chars.txt
# generator by-products: raw chroma-screen originals stay local (re-key with tools/key_unmix.py), Codex logs
/assets/**/*.raw.png
/assets/**/_logs/
# the repository root ignores *.png (earlier project); this project keeps its art and palettes
!/assets/**/*.png
!/docs/*.png
/assets/**/*.raw.png
